@* line icons of the android app (AppIcon.cs) on the same 24 × 24 grid; colour comes from currentColor *@
<svg class="nf-icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="@(Kind is AppIconKind.Plus or AppIconKind.Check ? "2.2" : "1.8")"
     stroke-linecap="round" stroke-linejoin="round">
    @switch (Kind)
    {
        case AppIconKind.Diary:
            <rect x="5" y="4" width="14" height="17" rx="3" />
            <path d="M9 2V6M15 2V6M9 11H15M9 15H13" />
            break;
        case AppIconKind.Products:
            <rect x="4" y="5" width="16" height="15" rx="3" />
            <path d="M4 10H20M9 5V20M15 5V20" />
            break;
        case AppIconKind.Dishes:
            <path d="M3 12H21M4 13L7 19H17L20 13M8 8L9 4M12 8L13 3M16 8L17 4" />
            break;
        case AppIconKind.Settings:
            <path d="M4 7H20M4 17H20" />
            <circle cx="10" cy="7" r="3" fill="currentColor" stroke="none" />
            <circle cx="15" cy="17" r="3" fill="currentColor" stroke="none" />
            break;
        case AppIconKind.Previous:
            <path d="M15 5L8 12L15 19" />
            break;
        case AppIconKind.Next:
            <path d="M9 5L16 12L9 19" />
            break;
        case AppIconKind.Expand:
            <path d="M5 9L12 16L19 9" />
            break;
        case AppIconKind.Target:
            <circle cx="12" cy="12" r="9" />
            <circle cx="12" cy="12" r="5" />
            <circle cx="12" cy="12" r="2" fill="currentColor" stroke="none" />
            break;
        case AppIconKind.More:
            <circle cx="5" cy="12" r="2" fill="currentColor" stroke="none" />
            <circle cx="12" cy="12" r="2" fill="currentColor" stroke="none" />
            <circle cx="19" cy="12" r="2" fill="currentColor" stroke="none" />
            break;
        case AppIconKind.Microphone:
            <rect x="9" y="2" width="6" height="12" rx="3" />
            <path d="M6 10V12C6 15.3 8.7 18 12 18C15.3 18 18 15.3 18 12V10M12 18V22M8 22H16" />
            break;
        case AppIconKind.Plus:
            <path d="M12 5V19M5 12H19" />
            break;
        case AppIconKind.Search:
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="M15 15L20 20" />
            break;
        case AppIconKind.Camera:
            <rect x="3" y="7" width="18" height="13" rx="3" />
            <path d="M8 7L9.5 4H14.5L16 7" />
            <circle cx="12" cy="13" r="3.5" />
            break;
        case AppIconKind.Barcode:
            <path d="M4 5V19M7 5V19M11 5V19M14 5V19M17 5V19M20 5V19" />
            break;
        case AppIconKind.Edit:
            <path d="M5 19L6 15L16 5L19 8L9 18L5 19M14 7L17 10" />
            break;
        case AppIconKind.Warning:
            <path d="M12 3L21 20H3Z M12 9V14" />
            <circle cx="12" cy="17" r="1" fill="currentColor" stroke="none" />
            break;
        case AppIconKind.Check:
            <path d="M5 12.5L10 17L19 7" />
            break;
        case AppIconKind.Refresh:
            <path d="M18.93 8A8 8 0 1 0 16 18.93M19 3V8H14" />
            break;
        case AppIconKind.Key:
            <circle cx="7" cy="13" r="4" />
            <path d="M11 13H21M17 13V17M20 13V16" />
            break;
        case AppIconKind.Archive:
            <rect x="3" y="4" width="18" height="5" rx="1.5" />
            <rect x="5" y="9" width="14" height="11" rx="2" />
            <path d="M10 13H14" />
            break;
        case AppIconKind.User:
            <circle cx="12" cy="7" r="4" />
            <path d="M4 21C4 16.5 7.6 14 12 14C16.4 14 20 16.5 20 21" />
            break;
        case AppIconKind.Sparkle:
            <path d="M11 3C11.6 7.8 13.2 9.4 18 10C13.2 10.6 11.6 12.2 11 17C10.4 12.2 8.8 10.6 4 10C8.8 9.4 10.4 7.8 11 3Z"
                  fill="currentColor" stroke="none" />
            <circle cx="19" cy="17" r="2" fill="currentColor" stroke="none" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public AppIconKind Kind { get; set; }

    [Parameter]
    public int Size { get; set; } = 24;

    [Parameter]
    public string? Class { get; set; }
}
