@* details on demand; the expanded state is announced through aria-expanded *@
<div class="nf-expander @Class">
    <button type="button" class="nf-expander__toggle" aria-expanded="@(Expanded ? "true" : "false")" aria-controls="@_id"
            data-testid="@TestId" @onclick="ToggleAsync">
        <span>@Title</span>
        <AppIcon Kind="AppIconKind.Expand" Size="18" Class="@(Expanded ? "nf-expander__chevron nf-expander__chevron--open" : "nf-expander__chevron")" />
    </button>
    <div id="@_id" class="nf-expander__content" hidden="@(!Expanded)">
        @if (Expanded)
        {
            @ChildContent
        }
    </div>
</div>

@code {
    private readonly string _id = "details-" + Guid.NewGuid().ToString("N")[..8];

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // bound by a form that has to open the details itself, for example to show an error in a hidden field
    [Parameter]
    public bool Expanded { get; set; }

    [Parameter]
    public EventCallback<bool> ExpandedChanged { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private Task ToggleAsync()
    {
        Expanded = !Expanded;
        return ExpandedChanged.InvokeAsync(Expanded);
    }
}
