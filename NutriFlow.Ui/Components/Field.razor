@* a labelled text field; numbers take a comma or a dot and are parsed with NutritionText.ParseNumber *@
<div class="nf-field @Class">
    @if (Label is not null)
    {
        <label class="nf-field__label" for="@_id">@Label</label>
    }
    <input id="@_id" class="nf-field__input" type="text" value="@Value" placeholder="@Placeholder"
           inputmode="@(Number ? "decimal" : null)" enterkeyhint="@EnterKeyHint" maxlength="@MaxLength"
           autocomplete="off" spellcheck="@(Number ? "false" : null)" aria-describedby="@(Hint is null ? null : _id + "-hint")"
           data-testid="@TestId" @oninput="OnInputAsync" />
    @if (Hint is not null)
    {
        <p id="@(_id + "-hint")" class="nf-caption">@Hint</p>
    }
</div>

@code {
    private readonly string _id = "field-" + Guid.NewGuid().ToString("N")[..8];

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool Number { get; set; }

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public int? MaxLength { get; set; }

    [Parameter]
    public string? EnterKeyHint { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private Task OnInputAsync(ChangeEventArgs args)
    {
        Value = args.Value?.ToString();
        return ValueChanged.InvokeAsync(Value);
    }
}
