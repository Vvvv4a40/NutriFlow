@* a tinted note with an icon for things the user should know before going on (Notice in MainPage.xaml.cs) *@
<div class="nf-notice @PressableBase.ToneClass(Tone) @Class" data-testid="@TestId">
    <AppIcon Kind="Icon" Size="22" Class="nf-notice__icon" />
    <div class="nf-notice__body">
        <p class="nf-text">@ChildContent</p>
        @if (Action is not null)
        {
            <div class="nf-notice__action">@Action</div>
        }
    </div>
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Action { get; set; }

    [Parameter]
    public AppIconKind Icon { get; set; } = AppIconKind.Warning;

    [Parameter]
    public Tone Tone { get; set; } = Tone.Warning;

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? Class { get; set; }
}
