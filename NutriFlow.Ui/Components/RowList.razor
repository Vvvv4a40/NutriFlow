@* rows separated by hairlines inside one panel read as a single list *@
<div class="nf-panel nf-list @Class" data-testid="@TestId">@ChildContent</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? Class { get; set; }
}
