@inject LocalMealClient Meals
@inject ActionRunner Runner

@* a product by the digits under its barcode from Open Food Facts; the camera is not part of the first version
   (BarcodePageAsync in MainPage.Products.cs) *@
<FormPage Title="Поиск по штрихкоду" TestId="barcode-form" OnClose="OnClose">
    <ChildContent>
        <BodyText Muted="true">Введите цифры под штрихкодом. Поиск идёт по открытой базе Open Food Facts и требует интернета.</BodyText>
        <Field @ref="_field" Label="Штрихкод" Placeholder="Например, 4600000000000" Digits="true" Plain="true" MaxLength="20"
               EnterKeyHint="search" Error="@_error" TestId="barcode-input"
               @bind-Value="_code" @bind-Value:after="OnCodeChanged" OnEnter="FindAsync" />
        <div class="nf-barcode-result" tabindex="-1" @ref="_result">
            @if (_found is { } product)
            {
                <h2 class="nf-headline nf-barcode-result__title" tabindex="-1" data-testid="barcode-product-name" @ref="_title">@product.Name</h2>
                <Notice Icon="AppIconKind.Check" Tone="Tone.Success" TestId="barcode-found">Продукт добавлен в каталог. Сверьте значения с упаковкой.</Notice>
                <ProductCard Product="product" TestId="barcode-product" />
            }
            else if (_missing)
            {
                <Notice TestId="barcode-missing">
                    <ChildContent>@CatalogText.BarcodeNotFound</ChildContent>
                    <Action><GhostButton Text="Добавить вручную" TestId="barcode-add-manual" OnClick="() => _manual = true" /></Action>
                </Notice>
            }
        </div>
    </ChildContent>
    <Footer>
        @* one control in both states, so the focus stays on it; another search is Enter in the field *@
        <ActionButton Text="@(_found is null ? "Найти продукт" : "Записать порцию")" ProgressKey="barcode-find"
                      TestId="@(_found is null ? "barcode-find" : "barcode-portion")" OnClick="MainActionAsync" />
    </Footer>
</FormPage>

@if (_portion && _found is { } chosen)
{
    <ProductPortionForm ProfileId="ProfileId" Product="chosen" Date="Date" OnStarted="StartedAsync" OnClose="ClosePortionAsync" />
}

@if (_manual)
{
    <ProductForm ProfileId="ProfileId" InitialBarcode="@_searched" OnSaved="OnManualSavedAsync" OnClose="() => _manual = false" />
}

@code {
    private Field? _field;
    private ElementReference _result;
    private ElementReference _title;
    private string? _code;
    private string? _searched;
    private string? _error;
    private ProductResponse? _found;
    private bool _missing;
    private bool _portion;
    private bool _manual;
    private bool _focusResult;

    [Parameter, EditorRequired]
    public Guid ProfileId { get; set; }

    [Parameter]
    public DateOnly Date { get; set; }

    [Parameter]
    public EventCallback OnStarted { get; set; }

    // a product came into the catalog: the list under the form shows it
    [Parameter]
    public EventCallback OnCatalogChanged { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task FindAsync()
    {
        if (CatalogText.BarcodeProblem(_code) is { } problem)
        {
            _error = problem;
            StateHasChanged();
            await Task.Yield();
            await _field!.FocusAsync();
            return;
        }

        string code = _code!.Trim();
        await Runner.RunAsync(async () =>
        {
            Runner.ShowProgress("barcode-find", "Ищу продукт…");
            // the answer for the previous code must not pass for this one while the request runs
            _found = null;
            _missing = false;
            StateHasChanged();
            ProductResponse? found = null;
            try
            {
                found = await Meals.LookupBarcodeAsync(ProfileId, code);
            }
            catch (Exception exception) when (CatalogText.IsBarcodeMissing(exception))
            {
                Console.Error.WriteLine(exception);
            }
            catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException)
            {
                throw new InvalidOperationException(CatalogText.BarcodeError(exception), exception);
            }

            _found = found;
            _missing = found is null;
            _searched = code;
            _focusResult = true;
            if (found is not null)
            {
                await OnCatalogChanged.InvokeAsync();
            }
        });
    }

    // the result replaces the old one silently, the focus brings a screen reader to it
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusResult)
        {
            _focusResult = false;
            await (_found is null ? _result : _title).FocusAsync();
            // a focused block without a role is not read out, the announcement comes after the focus moved
            Runner.Announce(_found is { } product ? $"Найден продукт «{product.Name}»" : "Продукт не найден");
        }
    }

    private Task MainActionAsync()
    {
        if (_found is null)
        {
            return FindAsync();
        }

        _portion = true;
        return Task.CompletedTask;
    }

    // the result of the old digits must not stay under new ones: «Записать порцию» would take the wrong product
    private void OnCodeChanged()
    {
        _error = null;
        _found = null;
        _missing = false;
    }

    private Task ClosePortionAsync()
    {
        _portion = false;
        return Task.CompletedTask;
    }

    // the calculation opens in the food input, this form goes with the portion form
    private async Task StartedAsync()
    {
        await OnClose.InvokeAsync();
        await OnStarted.InvokeAsync();
    }

    // the product added by hand is in the list under this form
    private async Task OnManualSavedAsync()
    {
        await OnClose.InvokeAsync();
        await OnCatalogChanged.InvokeAsync();
        Runner.Announce("Продукт добавлен в каталог");
    }
}
