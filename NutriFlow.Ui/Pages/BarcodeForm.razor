@inject LocalMealClient Meals
@inject IAppHost Host
@inject ActionRunner Runner

@* a product by the photo of its barcode, or by the digits under it, from Open Food Facts *@
<FormPage Title="Штрихкод" TestId="barcode-form" OnClose="OnClose">
    <ChildContent>
        <div class="nf-barcode-result" tabindex="-1" @ref="_result">
            @if (_found is { } product)
            {
                <h2 class="nf-headline nf-barcode-result__title" tabindex="-1" data-testid="barcode-product-name" @ref="_title">@product.Name</h2>
                <Notice Icon="AppIconKind.Check" Tone="Tone.Success" TestId="barcode-found">Продукт добавлен в каталог. Сверьте значения с упаковкой.</Notice>
                <ProductCard Product="product" TestId="barcode-product" />
            }
            else if (_missing)
            {
                <Notice TestId="barcode-missing">
                    <ChildContent>@CatalogText.BarcodeNotFound</ChildContent>
                    <Action><GhostButton Text="Добавить вручную" TestId="barcode-add-manual" OnClick="() => _manual = true" /></Action>
                </Notice>
            }
            else if (_unread)
            {
                <Notice TestId="barcode-unread">@CatalogText.BarcodeUnread</Notice>
            }
        </div>
        @if (_found is null)
        {
            <IconTile Icon="AppIconKind.Barcode" Large="true" />
            <Headline>Сфотографируйте штрихкод</Headline>
            <BodyText Muted="true">Штрихкод крупно, ровно и без бликов. Продукт найдётся в открытой базе Open Food Facts, нужен интернет.</BodyText>
            <Field @ref="_field" Label="Или введите цифры под штрихкодом" Placeholder="Например, 4600000000000" Digits="true" Plain="true" MaxLength="20"
                   EnterKeyHint="search" Error="@_error" TestId="barcode-input"
                   @bind-Value="_code" @bind-Value:after="OnCodeChanged" OnEnter="FindAsync" />
            @if (!string.IsNullOrWhiteSpace(_code))
            {
                <ActionButton Text="Найти по цифрам" Secondary="true" ProgressKey="barcode-find" TestId="barcode-find" OnClick="FindAsync" />
            }
        }
    </ChildContent>
    <Footer>
        @if (_found is null)
        {
            <PhotoButton Text="Сфотографировать" Camera="true" ProgressKey="barcode-camera" TestId="barcode-camera"
                         OnPicked="input => OnPickedAsync(input, CameraKey)" />
            <PhotoButton Text="Выбрать из галереи" Secondary="true" ProgressKey="barcode-gallery" TestId="barcode-gallery"
                         OnPicked="input => OnPickedAsync(input, GalleryKey)" />
        }
        else
        {
            <ActionButton Text="Записать порцию" TestId="barcode-portion" OnClick="() => _portion = true" />
        }
    </Footer>
</FormPage>

@if (_portion && _found is { } chosen)
{
    <ProductPortionForm ProfileId="ProfileId" Product="chosen" Date="Date" OnStarted="StartedAsync" OnClose="ClosePortionAsync" />
}

@if (_manual)
{
    <ProductForm ProfileId="ProfileId" InitialBarcode="@_searched" OnSaved="OnManualSavedAsync" OnClose="() => _manual = false" />
}

@code {
    private const string CameraKey = "barcode-camera";
    private const string GalleryKey = "barcode-gallery";
    private Field? _field;
    private ElementReference _result;
    private ElementReference _title;
    private string? _code;
    private string? _searched;
    private string? _error;
    private ProductResponse? _found;
    private bool _missing;
    private bool _unread;
    private bool _portion;
    private bool _manual;
    private bool _focusResult;

    [Parameter, EditorRequired]
    public Guid ProfileId { get; set; }

    [Parameter]
    public DateOnly Date { get; set; }

    [Parameter]
    public EventCallback OnStarted { get; set; }

    // a product came into the catalog: the list under the form shows it
    [Parameter]
    public EventCallback OnCatalogChanged { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    // the file input is in the footer and stays there during the action, as for a photo of a label
    private Task OnPickedAsync(ElementReference input, string key) => Runner.RunAsync(async () =>
    {
        Runner.ShowProgress(key, "Читаю штрихкод…");
        _unread = false;
        _missing = false;
        _error = null;
        PickedBarcode? barcode;
        try
        {
            barcode = await Host.ReadBarcodeAsync(input);
        }
        catch (InvalidDataException exception)
        {
            UiLog.Error(exception);
            barcode = new PickedBarcode(null);
        }

        if (barcode is null)
        {
            return;
        }

        if (barcode.Digits is not { } digits || CatalogText.BarcodeProblem(digits) is not null)
        {
            _unread = true;
            _focusResult = true;
            return;
        }

        _code = digits;
        Runner.ShowProgress(key, "Ищу продукт…");
        await LookUpAsync(digits);
    });

    private async Task FindAsync()
    {
        if (CatalogText.BarcodeProblem(_code) is { } problem)
        {
            _error = problem;
            StateHasChanged();
            await Task.Yield();
            await _field!.FocusAsync();
            return;
        }

        string code = _code!.Trim();
        await Runner.RunAsync(async () =>
        {
            Runner.ShowProgress("barcode-find", "Ищу продукт…");
            await LookUpAsync(code);
        });
    }

    private async Task LookUpAsync(string code)
    {
        // the answer for the previous code must not pass for this one while the request runs
        _found = null;
        _missing = false;
        _unread = false;
        StateHasChanged();
        ProductResponse? found = null;
        try
        {
            found = await Meals.LookupBarcodeAsync(ProfileId, code);
        }
        catch (Exception exception) when (CatalogText.IsBarcodeMissing(exception))
        {
            UiLog.Error(exception);
        }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException)
        {
            throw new InvalidOperationException(CatalogText.BarcodeError(exception), exception);
        }

        _found = found;
        _missing = found is null;
        _searched = code;
        _focusResult = true;
        if (found is not null)
        {
            await OnCatalogChanged.InvokeAsync();
        }
    }

    // the result replaces the old one silently, the focus brings a screen reader to it
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusResult)
        {
            _focusResult = false;
            await (_found is null ? _result : _title).FocusAsync();
            // a focused block without a role is not read out, the announcement comes after the focus moved
            Runner.Announce(_found is { } product ? $"Найден продукт «{product.Name}»"
                : _unread ? CatalogText.BarcodeUnread
                : "Продукт не найден");
        }
    }

    // the result of the old digits must not stay under new ones
    private void OnCodeChanged()
    {
        _error = null;
        _found = null;
        _missing = false;
        _unread = false;
    }

    private Task ClosePortionAsync()
    {
        _portion = false;
        return Task.CompletedTask;
    }

    // the calculation opens in the food input, this form goes with the portion form
    private async Task StartedAsync()
    {
        await OnClose.InvokeAsync();
        await OnStarted.InvokeAsync();
    }

    // the product added by hand is in the list under this form
    private async Task OnManualSavedAsync()
    {
        await OnClose.InvokeAsync();
        await OnCatalogChanged.InvokeAsync();
        Runner.Announce("Продукт добавлен в каталог");
    }
}
