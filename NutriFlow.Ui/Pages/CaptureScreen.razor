@using NutriFlow.Domain
@implements IDisposable
@inject CaptureState Capture
@inject IProfileSettings Settings
@inject ActionRunner Runner

@* food input: the description or a clarification, its autosave and the preview of the session (MainPage.Input.cs) *@
@if (_loadError is not null)
{
    <div role="alert">
        <EmptyState Icon="AppIconKind.Warning" Title="Не удалось открыть сохранённый ввод" Message="@_loadError" TestId="input-error">
            <Action><ActionButton Text="Повторить" TestId="input-retry" OnClick="LoadAsync" /></Action>
        </EmptyState>
    </div>
}
else if (!_loaded)
{
    @* the saved input of the profile is read at start, this lasts a few milliseconds *@
}
else
{
    @if (Capture.Session is { } session)
    {
        @if (CaptureText.IsDiary(session))
        {
            <MealReview @ref="_review" Session="session" CanEstimate="_hasGroq" OnLine="LineActionsAsync" OnEstimate="EstimateAsync" />
        }
        else
        {
            <SessionPreview @ref="_preview" Session="session" OnAddProduct="name => OpenProductForm(name, null)" OnAnswer="FocusEditorAsync"
                            OnRefresh="RefreshAsync" />
        }
    }

    @if (Capture.Blocked)
    {
        @* a choice about the saved text comes first, the input waits for it *@
        <Card Class="nf-capture-recovery" TestId="input-draft-recovery">
            <BodyText>@(Capture.DraftProblem ?? "Остался неотправленный текст другой записи.")</BodyText>
            @if (Capture.PendingDraft is { } pending)
            {
                <div class="nf-capture-recovery__draft">
                    <Caption>@CaptureText.DraftContext(pending, Today)</Caption>
                    <BodyText Muted="true" Class="nf-capture-recovery__text" TestId="input-draft-text">@pending.Text</BodyText>
                </div>
                <ActionButton Text="Восстановить текст" TestId="input-draft-restore" OnClick="RestoreAsync" />
            }
            else
            {
                <ActionButton Text="Повторить чтение" Secondary="true" TestId="input-draft-reload" OnClick="ReloadAsync" />
            }
            <GhostButton Text="Удалить сохранённый текст" Danger="true" TestId="input-draft-discard" OnClick="DiscardAsync" />
        </Card>
    }
    else
    {
        @if (Capture.Session is null)
        {
            <Segmented Label="Что записать" Options="Purposes" Selected="@(Capture.Purpose == MealSessionPurpose.CreateDish ? 1 : 0)"
                       SelectedChanged="SelectPurpose" />
            <Caption TestId="input-context">@CaptureText.Context(Capture.Purpose, Capture.Date, Today)</Caption>
        }

        @if (!_hasGroq)
        {
            <Notice Icon="AppIconKind.Key" TestId="input-key-notice">
                <ChildContent>@CaptureText.NoKey</ChildContent>
                <Action><GhostButton Text="Открыть настройки" TestId="input-key-settings" OnClick="OnOpenSettings" /></Action>
            </Notice>
        }

        @* a correction of a ready calculation is a short remark, not a new description *@
        <div class="nf-panel nf-composer @(Capture.Session is not null ? "nf-composer--compact" : null)">
            @if (Capture.Session is { } current && !CaptureText.IsDiary(current))
            {
                <Overline>Уточнение</Overline>
            }
            <TextArea @ref="_editor" Rows="@(Capture.Session is null ? 6 : 2)" MaxLength="MealInputText.MaximumLength"
                      AccessibleLabel="@(Capture.Session is null ? "Описание еды" : "Уточнение")"
                      Placeholder="@CaptureText.Placeholder(Capture.Session is not null, Capture.Purpose)"
                      Value="@Capture.Text" ValueChanged="OnTextChanged" Error="@_error"
                      Class="nf-composer__text" TestId="input-description" />
            <div class="nf-composer__tools">
                @if (_hasGroq)
                {
                    <VoiceInput ProfileId="Profile.Id" Text="@Capture.Text" TextChanged="OnTextChanged" />
                }
                <Caption Class="nf-composer__status" Tone="@(Capture.SaveFailed ? Tone.Danger : (Tone?)null)" TestId="input-save-status">@Capture.SaveStatus</Caption>
                @if (Capture.SaveFailed)
                {
                    <GhostButton Text="Повторить сохранение" Class="nf-composer__retry" TestId="input-draft-retry" OnClick="RetrySaveAsync" />
                }
                <Caption Class="nf-composer__count">@CaptureText.Counter(Capture.Text.Length)</Caption>
            </div>
            @if (Capture.Session is not { CanConfirm: true } || !string.IsNullOrWhiteSpace(Capture.Text))
            {
                @* while the calculation waits for answers, sending them is the main step *@
                <ActionButton Text="@(Capture.Session is null ? "Разобрать описание" : "Отправить уточнение")"
                              Secondary="@(Capture.Session is { CanConfirm: true })"
                              ProgressKey="capture-submit" TestId="input-submit" OnClick="SubmitAsync" />
            }
        </div>

        @if (Capture.Session is null)
        {
            @* the manual ways need no Groq: a catalog product, a saved dish or a dish built from products *@
            <SectionHeader Title="Или без описания" />
            <RowList TestId="input-alternatives">
                @if (Capture.Purpose == MealSessionPurpose.CreateDish)
                {
                    <Row Title="Собрать из продуктов" Subtitle="Ингредиенты из каталога и готовый вес" Icon="AppIconKind.Dishes"
                         Description="Собрать из продуктов, ингредиенты из каталога и готовый вес" TestId="input-manual-dish"
                         OnClick="() => _buildingDish = true" />
                }
                else
                {
                    <Row Title="Продукт из каталога" Subtitle="Найти и указать вес порции" Icon="AppIconKind.Products"
                         Description="Продукт из каталога, найти и указать вес порции" TestId="input-manual-product" OnClick="OnOpenProducts" />
                    <Row Title="Моё блюдо" Subtitle="Порция сохранённого блюда" Icon="AppIconKind.Dishes"
                         Description="Моё блюдо, порция сохранённого блюда" TestId="input-saved-dishes" OnClick="OnOpenDishes" />
                }
            </RowList>
        }
        else
        {
            <GhostButton Text="Начать запись заново" Danger="true" Class="nf-capture-restart" TestId="draft-restart" OnClick="RestartAsync" />
        }
    }
}

@if (_buildingDish)
{
    <DishBuilderForm ProfileId="Profile.Id" Date="Date" OnStarted="OnDishStartedAsync" OnClose="() => _buildingDish = false" />
}

@if (_newProduct is { } productName)
{
    <ProductForm ProfileId="Profile.Id" InitialName="@productName" ExactName="true" Initial="_correctedProduct"
                 OnSaved="OnProductSavedAsync" OnClose="() => _newProduct = null" />
}

@if (_editingWeight is { } line)
{
    <ReviewWeightForm Line="line" OnClose="() => _editingWeight = null" />
}

@code {
    private static readonly SegmentedOption[] Purposes =
    [
        new("В дневник", "input-purpose-diary"),
        new("Создать блюдо", "input-purpose-dish")
    ];

    private bool _loaded;
    private string? _loadError;
    private bool _hasGroq = true;
    private string? _error;
    private string? _newProduct;
    private ProductResponse? _correctedProduct;
    private MealReviewLine? _editingWeight;
    private bool _buildingDish;
    private TextArea? _editor;
    private SessionPreview? _preview;
    private MealReview? _review;
    private bool _focusPreview;
    private bool _focusEditor;
    private bool _saveFailed;

    [Parameter, EditorRequired]
    public LocalProfile Profile { get; set; } = null!;

    // the day shown in the diary; a new description goes there
    [Parameter]
    public DateOnly Date { get; set; }

    [Parameter]
    public EventCallback OnOpenSettings { get; set; }

    [Parameter]
    public EventCallback OnOpenProducts { get; set; }

    [Parameter]
    public EventCallback OnOpenDishes { get; set; }

    // the host opened this screen for a calculation made elsewhere: its status is read first
    [Parameter]
    public bool FocusPreview { get; set; }

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        _focusPreview = FocusPreview;
        Capture.Changed += OnCaptureChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            // the warning comes before the first tap, not as an error after it
            _hasGroq = await Settings.HasGroqAsync(Profile.Id);
            await Capture.LoadAsync(Profile.Id);
            Capture.Open(Date);
            _loaded = true;
        }
        catch (Exception exception)
        {
            UiLog.Error(exception);
            _loadError = DiaryText.LoadFailed;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPreview && _review is not null && Capture.Session is { } diary && CaptureText.IsDiary(diary))
        {
            _focusPreview = false;
            await _review.FocusAsync();
        }
        else if (_focusPreview && _preview is not null)
        {
            _focusPreview = false;
            await _preview.FocusStatusAsync();
        }

        // the recovery card and its button are gone, the input takes the focus
        if (_focusEditor && _editor is not null)
        {
            _focusEditor = false;
            await _editor.FocusAsync();
        }
    }

    private void SelectPurpose(int index) =>
        Capture.SetPurpose(index == 1 ? MealSessionPurpose.CreateDish : MealSessionPurpose.Diary);

    private void OnTextChanged(string? text)
    {
        _error = null;
        Capture.SetText(text);
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(Capture.Text) && !Capture.Blocked)
        {
            _error = Capture.Session is null
                ? "Опишите, что вы съели, и вес, например: гречка 150 г."
                : "Напишите уточнение, например ответ на вопрос выше.";
            StateHasChanged();
            await Task.Yield();
            await _editor!.FocusAsync();
            return;
        }

        await Runner.RunAsync(async () =>
        {
            await Capture.SubmitAsync(text => Runner.ShowProgress("capture-submit", text));
            // the preview appears above the emptied field
            _focusPreview = true;
        });
    }

    private async Task FocusEditorAsync()
    {
        if (_editor is not null)
        {
            await _editor.FocusAsync();
        }
    }

    private void OpenProductForm(string name, ProductResponse? corrected)
    {
        _correctedProduct = corrected;
        _newProduct = name;
    }

    // one tap on a line of the calculation: the weight is what usually needs a fix
    private Task LineActionsAsync(MealReviewLine line) => Runner.RunAsync(async () =>
    {
        const string weight = "Изменить вес";
        const string own = "Указать свои КБЖУ";
        const string remove = "Убрать из записи";
        string[] actions = line.Product is not null || line.MissingProduct is not null ? [weight, own] : [weight];
        string? action = await Runner.ChooseAsync(line.Name, "Отмена", remove, actions);
        if (action == weight)
        {
            _editingWeight = line;
        }
        else if (action == own)
        {
            OpenProductForm(line.MissingProduct ?? line.Product!.Name, line.Product);
        }
        else if (action == remove)
        {
            await Capture.RemoveDishAsync(line.DishIndex);
            Capture.Open(Date);
        }
    });

    private Task EstimateAsync() => Runner.RunAsync(Capture.EstimateMissingAsync);

    // runs inside the action of the product form, so it does not start one of its own
    private async Task OnProductSavedAsync()
    {
        await Capture.RefreshAsync();
        _focusPreview = true;
    }

    private Task RefreshAsync() => Runner.RunAsync(async () =>
    {
        await Capture.RefreshAsync();
        _focusPreview = true;
    });

    // the dish built from products is a calculation on this same screen
    private Task OnDishStartedAsync()
    {
        _focusPreview = true;
        return Task.CompletedTask;
    }

    private Task RetrySaveAsync() => Runner.RunAsync(Capture.RetrySaveAsync);

    private Task RestartAsync() => Runner.RunAsync(async () =>
    {
        await Capture.FlushAsync();
        if (await Runner.ConfirmAsync("Начать заново?", "Текущий расчёт не подтверждён и будет закрыт. Дневник не изменится.",
                "Начать заново", "Оставить", destructive: true))
        {
            await Capture.RestartAsync();
            Capture.Open(Date);
            StateHasChanged();
            await Task.Yield();
            await _editor!.FocusAsync();
        }
    });

    private Task RestoreAsync() => Runner.RunAsync(async () =>
    {
        await Capture.RestoreDraftAsync((title, message, accept) => Runner.ConfirmAsync(title, message, accept, "Оставить"));
        _focusEditor = !Capture.Blocked;
    });

    private Task ReloadAsync() => Runner.RunAsync(async () =>
    {
        await Capture.ReloadDraftAsync();
        _focusEditor = !Capture.Blocked;
    });

    private Task DiscardAsync() => Runner.RunAsync(async () =>
    {
        if (await Runner.ConfirmAsync("Удалить сохранённый текст?",
                "Будет удалён только неотправленный текст этого профиля. Дневник, продукты и блюда останутся.",
                "Удалить", "Оставить", destructive: true))
        {
            await Capture.DiscardDraftAsync();
            Capture.Open(Date);
            _focusEditor = true;
        }
    });

    private void OnCaptureChanged()
    {
        // the status under the field changes silently, a failed save has to be heard once
        if (Capture.SaveFailed && !_saveFailed)
        {
            Runner.Announce(CaptureText.SaveFailed);
        }

        _saveFailed = Capture.SaveFailed;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Capture.Changed -= OnCaptureChanged;
        // leaving the section writes the last typed words at once
        Capture.SaveNow();
    }
}
