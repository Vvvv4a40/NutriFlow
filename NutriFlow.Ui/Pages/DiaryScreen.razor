@using System.Globalization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject LocalMealClient Meals
@inject ActionRunner Runner
@inject ThemeManager Themes
@inject IJSRuntime Js

@* the day: date, the arc of the goal, eaten and goal tiles, macro bars and the entries (MainPage.Diary.cs) *@
<div class="nf-date-pill @(Themes.Current.DateBackground == Themes.Current.Surface ? "nf-date-pill--outlined" : null)">
    <IconButton Icon="AppIconKind.Previous" Description="Предыдущий день" Class="nf-date-pill__step" TestId="diary-previous-day"
                OnClick="() => DateChanged.InvokeAsync(Date.AddDays(-1))" />
    <div class="nf-date-pill__current">
        <button type="button" class="nf-date-pill__button" data-testid="diary-date" aria-description="Выбрать дату"
                @onclick="OpenPickerAsync">@DiaryText.DateLabel(Date, Today)</button>
        <input type="date" class="nf-date-pill__input" tabindex="-1" aria-hidden="true" @ref="_picker"
               value="@Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" @onchange="OnPickedAsync" />
    </div>
    <IconButton Icon="AppIconKind.Next" Description="Следующий день" Class="nf-date-pill__step" TestId="diary-next-day"
                OnClick="() => DateChanged.InvokeAsync(Date.AddDays(1))" />
</div>

@if (_loadError is not null)
{
    <div role="alert">
        <EmptyState Icon="AppIconKind.Warning" Title="Не удалось открыть данные профиля" Message="@_loadError" TestId="diary-error">
            <Action><ActionButton Text="Повторить" TestId="diary-retry" OnClick="LoadAsync" /></Action>
        </EmptyState>
    </div>
}
else if (_progress is { } progress && (progress.Date == Date || !_slow))
{
    <DiarySummary Consumed="progress.Consumed" Goal="progress.Goal" OnEditGoal="() => _editingGoal = true" />
    @* takes the focus after a deletion: the row that opened the sheet is gone *@
    <div class="nf-diary-entries" role="region" aria-label="Записи" tabindex="-1" data-testid="diary-entries-region" @ref="_entries">
        @if (progress.Entries.Count == 0)
        {
            <EmptyState Icon="AppIconKind.Diary" Title="Пока пусто" TestId="diary-empty"
                        Message="Опишите, что съели, — текстом, голосом или выбрав продукт из каталога.">
                <Action><ActionButton Text="Записать еду" TestId="diary-empty-add" OnClick="OnAddFood" /></Action>
            </EmptyState>
        }
        else
        {
            <SectionHeader Title="Записи" Detail="@DiaryText.EntriesSummary(progress.Entries)" DetailTestId="diary-entries-summary" />
            <RowList TestId="diary-entries">
                @foreach (MealEntryResponse entry in progress.Entries)
                {
                    <Row @key="entry.Id" Title="@entry.Name" Trailing="@DiaryText.EntryCalories(entry)"
                         TrailingCaption="@($"{NutritionText.Amount(entry.WeightInGrams)} г")" Description="@DiaryText.EntryDescription(entry)"
                         Hint="Изменить вес или удалить запись" TestId="diary-entry" OnClick="() => EntryActionsAsync(entry)">
                        <SubtitleContent>
                            <MacroLine Protein="entry.Nutrition.ProteinGrams" Fat="entry.Nutrition.FatGrams" Carbs="entry.Nutrition.CarbohydratesGrams" />
                        </SubtitleContent>
                    </Row>
                }
            </RowList>
        }
    </div>
}
else if (_slow)
{
    <div class="nf-loading" role="status" data-testid="diary-loading">
        <Spinner />
        <Caption>Загружаю дневник…</Caption>
    </div>
}

@if (_editing is { } editing)
{
    <EntryForm ProfileId="Profile.Id" Entry="editing" OnSaved="ReloadAsync" OnClose="() => _editing = null" />
}

@if (_editingGoal)
{
    <GoalForm ProfileId="Profile.Id" Date="Date" Goal="_progress?.Goal" OnSaved="ReloadAsync" OnClose="() => _editingGoal = false" />
}

@code {
    private DailyProgressResponse? _progress;
    private string? _loadError;
    private DateOnly? _requested;
    private int _version;
    private bool _loading;
    private bool _slow;
    private MealEntryResponse? _editing;
    private bool _editingGoal;
    private ElementReference _picker;
    private ElementReference _entries;
    private bool _focusEntries;
    private IJSObjectReference? _module;

    [Parameter, EditorRequired]
    public LocalProfile Profile { get; set; } = null!;

    [Parameter]
    public DateOnly Date { get; set; }

    [Parameter]
    public EventCallback<DateOnly> DateChanged { get; set; }

    [Parameter]
    public EventCallback OnAddFood { get; set; }

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    protected override void OnInitialized() => Themes.Changed += OnThemeChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (_requested != Date)
        {
            await LoadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/NutriFlow.Ui/picker.mjs");
        }

        if (_focusEntries)
        {
            _focusEntries = false;
            await _entries.FocusAsync();
        }
    }

    // not through ActionRunner: the screen also loads while the action that switched the profile still runs.
    // a quick tap through the days can start several loads, only the last one may land
    private async Task LoadAsync()
    {
        int version = ++_version;
        DateOnly date = Date;
        _requested = date;
        _loading = true;
        // «Повторить» shows the loading state, a second failure then appears as a new alert
        _loadError = null;
        _ = ShowSlowLoadingAsync(version);
        try
        {
            // a day without its own goal shows the last one set before it, and the goal form starts from it
            DailyProgressResponse progress = await Meals.GetDailyProgressAsync(Profile.Id, date, carryGoalOver: true);
            if (version == _version)
            {
                _progress = progress;
                _loadError = null;
            }
        }
        catch (Exception exception)
        {
            if (version == _version)
            {
                UiLog.Error(exception);
                _progress = null;
                _loadError = DiaryText.LoadFailed;
            }
        }
        finally
        {
            if (version == _version)
            {
                _loading = false;
                _slow = false;
            }
        }
    }

    private async Task ShowSlowLoadingAsync(int version)
    {
        await Task.Delay(250);
        if (version == _version && _loading)
        {
            _slow = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private async Task OpenPickerAsync()
    {
        if (_module is not null && !Runner.IsBusy)
        {
            await _module.InvokeVoidAsync("showPicker", _picker);
        }
    }

    private Task OnPickedAsync(ChangeEventArgs args) =>
        DateOnly.TryParseExact(args.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly date) && date != Date
            ? DateChanged.InvokeAsync(date)
            : Task.CompletedTask;

    private Task EntryActionsAsync(MealEntryResponse entry) => Runner.RunAsync(async () =>
    {
        string? action = await Runner.ChooseAsync(DiaryText.EntryActionsTitle(entry), "Отмена", "Удалить", "Изменить вес");
        if (action == "Изменить вес")
        {
            _editing = entry;
        }
        else if (action == "Удалить" && await Runner.ConfirmAsync("Удалить запись?",
                     $"{entry.Name}, {NutritionText.Amount(entry.WeightInGrams)} г. Это нельзя отменить.", "Удалить", "Оставить", destructive: true))
        {
            await Meals.DeleteEntryAsync(Profile.Id, entry.Id, entry.Revision);
            await LoadAsync();
            _focusEntries = true;
        }
    });

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Themes.Changed -= OnThemeChanged;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
