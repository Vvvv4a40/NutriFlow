@using NutriFlow.Domain
@inject LocalMealClient Meals
@inject CaptureState Capture
@inject ActionRunner Runner

@* a portion of a saved dish; the calculation opens in the food input for the confirmation
   (DishDetailPageAsync in MainPage.Dishes.cs) *@
<FormPage Title="Порция блюда" TestId="dish-portion" OnClose="OnClose">
    <ChildContent>
        <Headline>@Dish.Name</Headline>
        <Card TestId="dish-portion-card">
            <NutritionBlock Caption="На 100 г" Value="Dish.NutritionPer100Grams" Estimated="@(Dish.NutritionQuality == "Estimated")" />
            <div class="nf-badges"><QualityBadge Quality="@Dish.NutritionQuality" /></div>
            <Caption>@CaptureText.FinalWeight(Dish.FinalWeightInGrams)</Caption>
        </Card>
        <Field @ref="_field" Label="Съеденная порция, г" Number="true" EnterKeyHint="done" Error="@_error" TestId="dish-portion-weight"
               Hint="@CatalogText.MealDay(Date, Today)" @bind-Value="_grams" @bind-Value:after="() => _error = null" OnEnter="PreviewAsync" />
        <SwitchRow Text="Вес указан примерно" TestId="dish-portion-estimated" @bind-Checked="_estimated" />
        <Card>
            <Expander Title="@($"Состав · {Detail.Dish.Ingredients.Count}")" TestId="dish-portion-ingredients-toggle">
                <ul class="nf-ingredients" role="list" data-testid="dish-portion-ingredients">
                    @foreach (IngredientPreviewResponse ingredient in Detail.Dish.Ingredients)
                    {
                        <li class="nf-ingredient">
                            <div class="nf-ingredient__text">
                                <span class="nf-text nf-text--strong">@(ingredient.ResolvedProduct?.Name ?? ingredient.ProductName)</span>
                                @if (ingredient.ResolvedProduct is { } product)
                                {
                                    <span class="nf-caption">@CatalogText.IngredientSource(product)</span>
                                }
                            </div>
                            <span class="nf-caption nf-ingredient__value">@CatalogText.SavedIngredientWeight(ingredient)</span>
                        </li>
                    }
                </ul>
            </Expander>
        </Card>
    </ChildContent>
    <Footer>
        <ActionButton Text="Посмотреть расчёт порции" TestId="dish-portion-preview" OnClick="PreviewAsync" />
    </Footer>
</FormPage>

@code {
    private Field? _field;
    private string? _grams;
    private string? _error;
    private bool _estimated;

    [Parameter, EditorRequired]
    public Guid ProfileId { get; set; }

    [Parameter, EditorRequired]
    public SavedDishDetailResponse Detail { get; set; } = null!;

    // the day shown in the diary
    [Parameter]
    public DateOnly Date { get; set; }

    [Parameter]
    public EventCallback OnStarted { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private SavedDishResponse Dish => Detail.SavedDish;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private async Task PreviewAsync()
    {
        if (!NutritionText.TryParseNumber(_grams, positive: true, out decimal grams))
        {
            _error = "Введите вес съеденной порции в граммах больше нуля, например 250.";
            StateHasChanged();
            await Task.Yield();
            await _field!.FocusAsync();
            return;
        }

        DataQuality quality = _estimated ? DataQuality.Estimated : DataQuality.Exact;
        await Runner.RunAsync(async () =>
        {
            if (await Capture.StartAsync(profileId => Meals.CreateSavedDishMealAsync(profileId, Dish.Id, grams, Date, quality),
                    CatalogText.ConfirmReplace(Runner)))
            {
                await OnClose.InvokeAsync();
                await OnStarted.InvokeAsync();
            }
        });
    }
}
