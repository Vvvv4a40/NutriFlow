@using Microsoft.JSInterop
@implements IDisposable
@inject ProfileState Profiles
@inject CaptureState Capture
@inject ActionRunner Runner
@inject IJSRuntime Js

@* the whole app: the welcome screen without profiles, otherwise the shell with the sections of the current profile *@
@if (_loadError is not null)
{
    <main class="nf-welcome nf-welcome--error" data-testid="startup-error">
        <div class="nf-welcome__intro">
            <h1 class="nf-title">Не удалось открыть данные профиля</h1>
            <BodyText>@_loadError</BodyText>
        </div>
        <div class="nf-welcome__space"></div>
        <div class="nf-welcome__actions">
            <ActionButton Text="Повторить" TestId="startup-retry" OnClick="LoadAsync" />
        </div>
    </main>
}
else if (!_loaded)
{
    @* profiles.json is in memory already, this lasts a few milliseconds *@
}
else if (Profiles.Current is not { } profile)
{
    <WelcomeScreen OnStart="() => _creatingProfile = true" />
}
else
{
    <AppShell @ref="_shell" Title="@TitleText" ProfileName="@profile.Name" Selected="_tab" SelectedChanged="SelectTabAsync" OnProfile="ChooseProfileAsync"
              ActionBar="@(_tab == ShellTab.Input && Capture.Session is not null ? ConfirmBar : null)">
        <ChildContent>
            @if (_tab != ShellTab.Input && Capture.ProfileId == profile.Id && Capture.Blocked)
            {
                <Notice TestId="input-draft-attention">
                    <ChildContent>@(Capture.DraftProblem ?? "Есть неотправленный текст другой записи.")</ChildContent>
                    <Action><GhostButton Text="Проверить сохранённый ввод" OnClick="() => SelectTabAsync(ShellTab.Input)" /></Action>
                </Notice>
            }
            @switch (_tab)
            {
                case ShellTab.Diary:
                    <DiaryScreen @key="profile.Id" Profile="profile" Date="_date" DateChanged="date => _date = date"
                                 OnAddFood="() => SelectTabAsync(ShellTab.Input)" />
                    break;
                case ShellTab.Products:
                    <ProductsScreen @key="profile.Id" Profile="profile" Date="_date" OnStarted="OpenStartedAsync" />
                    break;
                case ShellTab.Input:
                    <CaptureScreen @key="profile.Id" Profile="profile" Date="_date" FocusPreview="_focusPreview"
                                   OnOpenSettings="() => SelectTabAsync(ShellTab.Settings)"
                                   OnOpenProducts="() => SelectTabAsync(ShellTab.Products)" OnOpenDishes="() => SelectTabAsync(ShellTab.Dishes)" />
                    break;
                case ShellTab.Dishes:
                    <DishesScreen @key="profile.Id" Profile="profile" Date="_date" OnStarted="OpenStartedAsync"
                                  OnOpenInput="() => SelectTabAsync(ShellTab.Input)" />
                    break;
                case ShellTab.Settings:
                    <SettingsScreen @key="profile.Id" Profile="profile" OnChooseProfile="ChooseProfileAsync" DeveloperTools="DeveloperTools" />
                    break;
            }
        </ChildContent>
    </AppShell>
}

@if (_creatingProfile)
{
    <ProfileForm OnClose="() => _creatingProfile = false" />
}

@code {
    private bool _loaded;
    private string? _loadError;
    private bool _creatingProfile;
    private AppShell? _shell;
    private Guid? _shownProfileId;
    private bool _focusShell;
    private string? _announcement;
    private bool _focusPreview;
    private ShellTab _tab = ShellTab.Diary;
    private DateOnly _date = Today;

    // host tools shown at the end of the settings, for example test data in development
    [Parameter]
    public RenderFragment<Guid>? DeveloperTools { get; set; }

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private RenderFragment ConfirmBar => @<ConfirmSessionButton OnConfirmed="OnConfirmedAsync" />;

    private string TitleText => _tab switch
    {
        ShellTab.Products => "Продукты",
        ShellTab.Input => CaptureText.Title(Capture.Session, Capture.Purpose),
        ShellTab.Dishes => "Блюда",
        ShellTab.Settings => "Настройки",
        _ => "Дневник"
    };

    protected override async Task OnInitializedAsync()
    {
        Profiles.Changed += OnProfileChanged;
        Capture.Changed += OnCaptureChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _loadError = null;
            await Profiles.LoadAsync();
            // the saved input is read at start, so other sections can point to text waiting for a decision
            if (Profiles.Current is { } current)
            {
                await Capture.LoadAsync(current.Id);
            }

            _loaded = true;
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine(exception);
            _loadError = DiaryText.LoadFailed;
        }
    }

    private async Task SelectTabAsync(ShellTab tab)
    {
        // leaving the input writes the last typed words at once
        Capture.SaveNow();
        _tab = tab;
        // every section starts at its top, as on the phone
        await Js.InvokeVoidAsync("scrollTo", 0, 0);
    }

    private Task ChooseProfileAsync() => Runner.RunAsync(async () =>
    {
        await Capture.FlushAsync();
        ProfileChoices choices = new(await Profiles.ListAsync(), Profiles.Current?.Id);
        string? choice = await Runner.ChooseAsync("Профили на этом устройстве", "Отмена", null, choices.Buttons);
        if (choice == ProfileChoices.Create)
        {
            _creatingProfile = true;
        }
        else if (choices.Find(choice) is { } selected && selected.Id != Profiles.Current?.Id)
        {
            await Profiles.SelectAsync(selected.Id);
        }
    });

    // a calculation made in the catalog or the dishes: the food input shows it for the confirmation
    private async Task OpenStartedAsync()
    {
        _focusPreview = true;
        await SelectTabAsync(ShellTab.Input);
    }

    // the diary with the new entry or the dishes with the new dish are already on screen,
    // so only a problem with the saved input needs a dialog
    private async Task OnConfirmedAsync(ConfirmMealSessionResponse result)
    {
        if (result.SavedDish is null)
        {
            _date = result.Session.MealDate;
        }

        await SelectTabAsync(result.SavedDish is null ? ShellTab.Diary : ShellTab.Dishes);
        _focusShell = true;
        StateHasChanged();
        string message = result.SavedDish is { } dish ? $"Блюдо «{dish.Name}» сохранено" : "Запись добавлена в дневник";
        if (Capture.DraftProblem is { } problem)
        {
            await Runner.AlertAsync("Сохранено", $"{message}. {problem}", "Готово");
            return;
        }

        _announcement = message;
    }

    // the control that had the focus left with the old screen (the welcome start button, the profile row of the
    // settings recreated for the new profile); the shell title takes it once the form is closed
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // the input screen took the flag when it was created
        if (_focusPreview && _tab == ShellTab.Input)
        {
            _focusPreview = false;
        }

        if (_focusShell && !_creatingProfile && _shell is not null)
        {
            _focusShell = false;
            await _shell.FocusTitleAsync();
        }

        if (_announcement is { } announcement && !_focusShell)
        {
            _announcement = null;
            Runner.Announce(announcement);
        }
    }

    // another profile starts at today, like a fresh start of the phone app
    private void OnProfileChanged()
    {
        _focusShell |= _loaded && Profiles.Current is not null && Profiles.Current.Id != _shownProfileId;
        _shownProfileId = Profiles.Current?.Id;
        _date = Today;
        // the input screen waits for the same load and shows its error
        if (Profiles.Current is { } current)
        {
            _ = Capture.LoadAsync(current.Id);
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void OnCaptureChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Profiles.Changed -= OnProfileChanged;
        Capture.Changed -= OnCaptureChanged;
    }
}
