@* products and dishes, whose screens come with step 7 of the web app; each points to what already works *@
@switch (Tab)
{
    case ShellTab.Dishes:
        <EmptyState Icon="AppIconKind.Dishes" Title="Список блюд появится в следующей версии" TestId="pending-dishes"
                    Message="Блюда, сохранённые через «Создать блюдо», уже хранятся в профиле и появятся здесь. А пока откройте дневник.">
            <Action><ActionButton Text="Открыть дневник" Secondary="true" TestId="pending-open-diary" OnClick="OnOpenDiary" /></Action>
        </EmptyState>
        break;
    default:
        <EmptyState Icon="AppIconKind.Products" Title="Продукты появятся в следующей версии" TestId="pending-products"
                    Message="Каталог, поиск и продукты по штрихкоду готовятся. Продукт уже можно добавить из расчёта: кнопка «Добавить пищевую ценность».">
            <Action><ActionButton Text="Открыть дневник" Secondary="true" TestId="pending-open-diary" OnClick="OnOpenDiary" /></Action>
        </EmptyState>
        break;
}

@code {
    [Parameter, EditorRequired]
    public ShellTab Tab { get; set; }

    [Parameter]
    public EventCallback OnOpenDiary { get; set; }
}
