@using NutriFlow.Domain
@using NutriFlow.Ui.Catalog
@inject LocalMealClient Meals
@inject ActionRunner Runner

@* a catalog product typed in from the package or checked against a photo of its label (ProductEditorPageAsync in
   MainPage.Products.cs) *@
<FormPage Title="@(Label is null ? "Новый продукт" : "Проверка этикетки")" TestId="product-form"
          CanLeave="@(Label is null ? null : CanLeaveAsync)" OnClose="OnClose">
    <ChildContent>
        @if (Reason is not null)
        {
            <Notice Icon="AppIconKind.Products" Tone="Tone.Accent" TestId="product-form-reason">@Reason</Notice>
        }
        @if (Label is { } label)
        {
            <LabelPhoto Photo="label.Photo" />
            <Notice Tone="@(label.Capture.Draft.Basis == NutritionBasis.Per100Grams ? Tone.Accent : Tone.Warning)"
                    Icon="@(label.Capture.Draft.Basis == NutritionBasis.Per100Grams ? AppIconKind.Check : AppIconKind.Warning)" TestId="label-note">
                @LabelText.Note(label.Capture.Draft.Basis)
                @foreach (string question in label.Capture.Draft.ClarificationQuestions)
                {
                    <span class="nf-label-question">@question</span>
                }
            </Notice>
        }
        else
        {
            <BodyText Muted="true">Перенесите значения на 100 г с упаковки или из другого известного источника.</BodyText>
        }
        <Field @ref="_nameField" Label="Название" Placeholder="Например, Творог 5% «Простоквашино»" MaxLength="200"
               Error="@_errors.GetValueOrDefault(NameKey)" Hint="@NameHint" TestId="product-name"
               @bind-Value="_name" @bind-Value:after="() => _errors.Remove(NameKey)" />
        <Overline>@(Label is null ? "Пищевая ценность на 100 г" : LabelText.ValuesTitle(Label.Capture.Draft.Basis))</Overline>
        <div class="nf-field-grid">
            @foreach (NutrientField field in Nutrients)
            {
                <Field @ref="_fields[field.Key]" Label="@field.Label" Number="true" Error="@_errors.GetValueOrDefault(field.Key)"
                       TestId="@($"product-{field.Key}")" Value="@_values.GetValueOrDefault(field.Key)"
                       ValueChanged="value => OnNutrientChanged(field.Key, value)" />
            }
        </div>
        <Field @ref="_barcodeField" Label="Штрихкод" Placeholder="Необязательно" Digits="true" Plain="true" MaxLength="32"
               Error="@_errors.GetValueOrDefault(BarcodeKey)" TestId="product-barcode"
               @bind-Value="_barcode" @bind-Value:after="() => _errors.Remove(BarcodeKey)" />
        @if (Label is { } checkedLabel)
        {
            <SwitchRow @ref="_checkedSwitch" Text="@LabelText.CheckedTitle" Hint="@LabelText.CheckedHint(checkedLabel.Capture.Draft.Basis)"
                       Error="@_errors.GetValueOrDefault(CheckedKey)" TestId="product-checked"
                       @bind-Checked="_checked" @bind-Checked:after="() => _errors.Remove(CheckedKey)" />
        }
        else
        {
            <SwitchRow Text="Значения приблизительные" Hint="Например, взяты по похожему продукту" TestId="product-estimated"
                       @bind-Checked="_estimated" />
        }
    </ChildContent>
    <Footer>
        <ActionButton Text="Сохранить продукт" TestId="product-save" OnClick="SaveAsync" />
    </Footer>
</FormPage>

@code {
    private const string NameKey = "name";
    private const string BarcodeKey = "barcode";
    private const string CheckedKey = "checked";

    private sealed record NutrientField(string Key, string Label, string Error);

    private static readonly NutrientField[] Nutrients =
    [
        new("calories", "Калории, ккал", "Введите калории, например 110."),
        new("protein", "Белки, г", "Введите белки, например 3,6 или 0."),
        new("fat", "Жиры, г", "Введите жиры, например 1,3 или 0."),
        new("carbs", "Углеводы, г", "Введите углеводы, например 21,3 или 0.")
    ];

    private readonly Dictionary<string, Field?> _fields = [];
    private readonly Dictionary<string, string?> _values = [];
    private readonly Dictionary<string, string> _errors = [];
    private Field? _nameField;
    private Field? _barcodeField;
    private SwitchRow? _checkedSwitch;
    private string? _name;
    private string? _barcode;
    private bool _estimated;
    private bool _checked;

    [Parameter, EditorRequired]
    public Guid ProfileId { get; set; }

    [Parameter]
    public string? InitialName { get; set; }

    // the name is an ingredient of the preview without nutrition: the calculation looks for exactly this name
    [Parameter]
    public bool ExactName { get; set; }

    [Parameter]
    public string? InitialBarcode { get; set; }

    // why the form opened instead of the screen the user asked for, for example an empty catalog
    [Parameter]
    public string? Reason { get; set; }

    // what the photo of a label gave; the product keeps a reference to the photo saved in the profile
    [Parameter]
    public LabelReading? Label { get; set; }

    [Parameter]
    public EventCallback<ProductResponse> OnSaved { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    // the calculation matches products by their exact name, another name would leave the ingredient without nutrition
    private string? NameHint => !ExactName || InitialName is null ? null
        : $"Расчёт найдёт продукт по названию «{InitialName}». Другое название в расчёт не подставится.";

    protected override void OnInitialized()
    {
        _name = InitialName;
        _barcode = InitialBarcode;
        if (Label?.Capture.Draft is { } draft)
        {
            _name = draft.ProductName;
            Fill("calories", draft.Calories);
            Fill("protein", draft.ProteinGrams);
            Fill("fat", draft.FatGrams);
            Fill("carbs", draft.CarbohydratesGrams);
        }
    }

    // a value the label does not show stays empty: nothing is made up for it
    private void Fill(string key, decimal? value)
    {
        if (value is decimal number)
        {
            _values[key] = NutritionText.Amount(number);
        }
    }

    private Task<bool> CanLeaveAsync() =>
        Runner.ConfirmAsync("Выйти без сохранения продукта?", "Значения с этикетки не сохранятся.", "Выйти", "Остаться", destructive: true);

    private void OnNutrientChanged(string key, string? value)
    {
        _values[key] = value;
        _errors.Remove(key);
    }

    private async Task SaveAsync()
    {
        _errors.Clear();
        string name = (_name ?? "").Trim();
        if (name.Length == 0)
        {
            _errors[NameKey] = "Введите название продукта, например «Гречка отварная».";
        }

        Dictionary<string, decimal> numbers = [];
        foreach (NutrientField field in Nutrients)
        {
            if (NutritionText.TryParseNumber(_values.GetValueOrDefault(field.Key), positive: false, out decimal value))
            {
                numbers[field.Key] = value;
            }
            else
            {
                _errors[field.Key] = field.Error;
            }
        }

        if (!string.IsNullOrWhiteSpace(_barcode) && CatalogText.BarcodeProblem(_barcode) is { } barcodeProblem)
        {
            _errors[BarcodeKey] = barcodeProblem;
        }

        if (Label is not null && LabelText.CheckProblem(Label.Capture.Draft.Basis, _checked) is { } checkProblem)
        {
            _errors[CheckedKey] = checkProblem;
        }

        if (_errors.Count > 0)
        {
            await ShowErrorAsync();
            return;
        }

        string? barcode = string.IsNullOrWhiteSpace(_barcode) ? null : _barcode.Trim();
        ProductResponse product = Label is null
            ? new(name, numbers["calories"], numbers["protein"], numbers["fat"], numbers["carbs"],
                "ManualInput", _estimated ? "Estimated" : "Exact", "Ручной ввод пользователя", null, barcode)
            : LabelText.Product(name, numbers["calories"], numbers["protein"], numbers["fat"], numbers["carbs"],
                _checked, Label.Capture.PhotoReference, barcode);
        bool duplicate = false;
        await Runner.RunAsync(async () =>
        {
            if (!await Meals.AddProductAsync(ProfileId, product))
            {
                duplicate = true;
                return;
            }

            await OnClose.InvokeAsync();
            await OnSaved.InvokeAsync(product);
        });

        if (duplicate)
        {
            _errors[NameKey] = "Продукт с таким названием уже есть. Выберите другое название, например добавьте марку.";
            await ShowErrorAsync();
        }
    }

    // the first wrong field takes the focus; every error stays under its own field
    private async Task ShowErrorAsync()
    {
        StateHasChanged();
        await Task.Yield();
        Field? first = _errors.ContainsKey(NameKey)
            ? _nameField
            : Nutrients.Where(field => _errors.ContainsKey(field.Key)).Select(field => _fields.GetValueOrDefault(field.Key)).FirstOrDefault()
              ?? (_errors.ContainsKey(BarcodeKey) ? _barcodeField : null);
        if (first is not null)
        {
            await first.FocusAsync();
        }
        else if (_errors.ContainsKey(CheckedKey) && _checkedSwitch is not null)
        {
            await _checkedSwitch.FocusAsync();
        }
    }
}
