@implements IAsyncDisposable
@inject IAppHost Host
@inject LocalMealClient Meals
@inject IProfileSettings Settings
@inject CaptureState Capture
@inject ActionRunner Runner

@* speech becomes text the user checks before it joins the description (AudioPageAsync in MainPage.Media.cs) *@
<FormPage Title="Голосом" TestId="voice-form" CanLeave="CanLeaveAsync" OnClose="OnClose">
    <ChildContent>
        @if (!_hasGroq)
        {
            <Notice Icon="AppIconKind.Key" TestId="voice-key-notice">
                <ChildContent>@VoiceText.NoKey</ChildContent>
                <Action><GhostButton Text="Открыть настройки" TestId="voice-key-settings" OnClick="OnOpenSettings" /></Action>
            </Notice>
        }
        else
        {
            <div class="nf-voice @(_voice.Phase == VoicePhase.Recording ? "nf-voice--recording" : null)">
                <IconTile Icon="AppIconKind.Microphone" Large="true" Tone="@(_voice.Phase == VoicePhase.Recording ? Tone.Danger : Tone.Accent)" />
                <BodyText Muted="@(_voice.Phase != VoicePhase.Recording)" Strong="@(_voice.Phase == VoicePhase.Recording)"
                          Class="nf-voice__status" TestId="voice-status">@VoiceText.Status(_voice)</BodyText>
                @if (_voice.Phase == VoicePhase.Transcribing)
                {
                    <Spinner />
                }
                @* one control in every phase, so the focus stays on it *@
                <ActionButton @ref="_recordButton" Text="@VoiceText.RecordButton(_voice)" Class="nf-voice__record" TestId="voice-record"
                              Secondary="@((HasText || _voice.CanRetry) && _voice.Phase == VoicePhase.Idle)"
                              Waiting="@(_voice.Phase is VoicePhase.Requesting or VoicePhase.Transcribing)" OnClick="RecordAsync" />
            </div>
            @if (_voice.Error is { } error)
            {
                <div role="alert">
                    <Notice Tone="Tone.Danger" TestId="voice-error">@error</Notice>
                </div>
            }
            @if (_voice.CanRetry)
            {
                <ActionButton Text="Повторить распознавание" TestId="voice-retry" OnClick="RetryAsync" />
            }
        }
        <TextArea @ref="_field" Label="Текст" Rows="6" MaxLength="MealInputText.MaximumLength"
                  Placeholder="Здесь появится распознанный текст — его можно исправить или ввести вручную"
                  Value="@_voice.Text" ValueChanged="OnTextChanged" Error="@_textError" TestId="voice-text" />
        <Caption>Аудио отправляется в Groq только для распознавания. Текст попадёт в описание еды после вашей проверки.</Caption>
    </ChildContent>
    <Footer>
        <ActionButton Text="Добавить в описание" Secondary="@(!HasText || _voice.CanRetry || _voice.Phase != VoicePhase.Idle)" TestId="voice-use" OnClick="UseAsync" />
    </Footer>
</FormPage>

@code {
    private VoiceCapture _voice = null!;
    private TextArea? _field;
    private ActionButton? _recordButton;
    private string? _textError;
    private bool _hasGroq = true;
    private VoicePhase _lastPhase;
    private bool _lastRecognised;
    private bool _warnedAboutLimit;

    [Parameter, EditorRequired]
    public Guid ProfileId { get; set; }

    [Parameter]
    public EventCallback OnOpenSettings { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool HasText => !string.IsNullOrWhiteSpace(_voice.Text);

    protected override async Task OnInitializedAsync()
    {
        _voice = new VoiceCapture(Host.CreateVoiceRecorder(), Meals, Settings, ProfileId);
        _voice.Changed += OnVoiceChanged;
        // the warning comes before the first tap, not as an error after it
        _hasGroq = await Settings.HasGroqAsync(ProfileId);
    }

    private void OnVoiceChanged()
    {
        if (_voice.Phase != _lastPhase)
        {
            _lastPhase = _voice.Phase;
            _textError = null;
            // the recording itself starts silently: a screen reader talking over it would end up in the text
            string? announcement = _voice.Phase switch
            {
                VoicePhase.Requesting => "Начинаю запись",
                VoicePhase.Transcribing when _voice.StoppedByItself => "Запись остановилась. Распознаю запись",
                VoicePhase.Transcribing => "Распознаю запись",
                _ => null
            };
            if (announcement is not null)
            {
                Runner.Announce(announcement);
            }

            _warnedAboutLimit = _warnedAboutLimit && _voice.Phase == VoicePhase.Recording;
        }

        if (_voice.Recognised && !_lastRecognised)
        {
            _textError = null;
            Runner.Announce(VoiceText.Status(_voice));
        }

        _lastRecognised = _voice.Recognised;
        // the status changes every second while recording, a screen reader only hears that the limit is near
        if (VoiceText.LimitIsNear(_voice) && !_warnedAboutLimit)
        {
            _warnedAboutLimit = true;
            Runner.Announce("Осталось 10 секунд");
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private Task RecordAsync() => _voice.Phase switch
    {
        VoicePhase.Idle => _voice.StartAsync(),
        VoicePhase.Recording => _voice.StopAsync(),
        _ => Task.CompletedTask
    };

    // the retry button goes away with the failure, the focus must not fall to the top of the page
    private async Task RetryAsync()
    {
        if (_recordButton is not null)
        {
            await _recordButton.FocusAsync();
        }

        await _voice.RetryAsync();
    }

    private void OnTextChanged(string? text)
    {
        _textError = null;
        _voice.SetText(text);
    }

    private async Task UseAsync()
    {
        _textError = _voice.Phase != VoicePhase.Idle ? VoiceText.Busy : !HasText ? VoiceText.Empty : null;
        string combined = "";
        if (_textError is null)
        {
            try
            {
                combined = MealInputText.AppendTranscript(Capture.Text, _voice.Text);
            }
            catch (ArgumentException exception)
            {
                _textError = exception.Message;
            }
        }

        if (_textError is not null)
        {
            StateHasChanged();
            await Task.Yield();
            await _field!.FocusAsync();
            return;
        }

        await Runner.RunAsync(async () =>
        {
            Capture.SetText(combined);
            await Capture.FlushAsync();
            await OnClose.InvokeAsync();
            Runner.Announce("Текст добавлен в описание");
        });
    }

    // a recording that only waits for another request to Groq cannot be spoken again as easily as it was the first time
    private Task<bool> CanLeaveAsync() =>
        _voice.Phase == VoicePhase.Idle && !HasText && !_voice.CanRetry
            ? Task.FromResult(true)
            : Runner.ConfirmAsync("Выйти без текста?", "Аудио и текст не сохранятся.", "Выйти", "Остаться", destructive: true);

    public async ValueTask DisposeAsync()
    {
        _voice.Changed -= OnVoiceChanged;
        await _voice.DisposeAsync();
    }
}
