@implements IDisposable
@inject IAppHost Host
@inject ActionRunner Runner

@* first start without profiles (RenderWelcome in MainPage.Navigation.cs) *@
<main class="nf-welcome" data-testid="welcome">
    <div class="nf-welcome__intro">
        <IconTile Icon="AppIconKind.Sparkle" Large="true" />
        <h1 class="nf-welcome__title" data-testid="welcome-title">NutriFlow</h1>
        <p class="nf-welcome__tagline">Опишите еду своими словами — калории и БЖУ посчитаются по весу.</p>
        <ul class="nf-welcome__features">
            <li class="nf-welcome__feature"><IconTile Icon="AppIconKind.Microphone" /><span class="nf-text">Текст, голос или фото этикетки</span></li>
            <li class="nf-welcome__feature"><IconTile Icon="AppIconKind.Check" /><span class="nf-text">Калории считаются по весу, оценки помечены</span></li>
            <li class="nf-welcome__feature"><IconTile Icon="AppIconKind.Archive" /><span class="nf-text">Данные хранятся только на этом устройстве</span></li>
        </ul>
    </div>
    <div class="nf-welcome__space"></div>
    <div class="nf-welcome__actions">
        <UpdateBanner Secondary="true" />
        @if (Host.IsTestChannel)
        {
            <Notice TestId="test-channel">Тестовая версия: данные с этого адреса не перенесутся в постоянную версию.</Notice>
        }
        <ActionButton Text="Начать" Class="nf-button--large" TestId="create-profile" OnClick="OnStart" />
        @if (Host.CanInstall)
        {
            <ActionButton Text="Установить приложение" Secondary="true" TestId="welcome-install" OnClick="() => AppInstall.RunAsync(Runner, Host)" />
        }
        <GhostButton Text="Восстановить из копии" TestId="welcome-backup-restore" OnClick="OnRestore" />
    </div>
</main>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }

    [Parameter]
    public EventCallback OnRestore { get; set; }

    protected override void OnInitialized() => Host.Changed += OnHostChanged;

    private void OnHostChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Host.Changed -= OnHostChanged;
}
