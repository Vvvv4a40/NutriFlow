<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:NutriFlow.Mobile"
             x:Class="NutriFlow.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{x:Static local:Ui.Background}" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{x:Static local:Ui.TextPrimary}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAutoScalingEnabled" Value="True" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>
            <Style TargetType="Entry" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{x:Static local:Ui.SurfaceRaised}" />
                <Setter Property="TextColor" Value="{x:Static local:Ui.TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{x:Static local:Ui.Muted}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAutoScalingEnabled" Value="True" />
                <Setter Property="MinimumHeightRequest" Value="48" />
            </Style>
            <Style TargetType="Editor" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{x:Static local:Ui.SurfaceRaised}" />
                <Setter Property="TextColor" Value="{x:Static local:Ui.TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{x:Static local:Ui.Muted}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAutoScalingEnabled" Value="True" />
                <Setter Property="MinimumHeightRequest" Value="96" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="BackgroundColor" Value="{x:Static local:Ui.SurfaceRaised}" />
                <Setter Property="TextColor" Value="{x:Static local:Ui.TextPrimary}" />
                <Setter Property="TitleColor" Value="{x:Static local:Ui.Muted}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAutoScalingEnabled" Value="True" />
                <Setter Property="MinimumHeightRequest" Value="48" />
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="BackgroundColor" Value="{x:Static local:Ui.SurfaceRaised}" />
                <Setter Property="TextColor" Value="{x:Static local:Ui.TextPrimary}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAutoScalingEnabled" Value="True" />
                <Setter Property="MinimumHeightRequest" Value="48" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{x:Static local:Ui.Accent}" />
                <Setter Property="TextColor" Value="{x:Static local:Ui.Background}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontAutoScalingEnabled" Value="True" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinimumHeightRequest" Value="48" />
                <Setter Property="MinimumWidthRequest" Value="48" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{x:Static local:Ui.AccentPressed}" />
                                    <Setter Property="TextColor" Value="{x:Static local:Ui.Background}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Focused">
                                <VisualState.Setters>
                                    <Setter Property="BorderColor" Value="{x:Static local:Ui.Accent}" />
                                    <Setter Property="BorderWidth" Value="2" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{x:Static local:Ui.SurfaceRaised}" />
                                    <Setter Property="TextColor" Value="{x:Static local:Ui.Muted}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Color" Value="{x:Static local:Ui.Accent}" />
                <Setter Property="MinimumHeightRequest" Value="48" />
                <Setter Property="MinimumWidthRequest" Value="48" />
            </Style>
            <Style TargetType="ActivityIndicator">
                <Setter Property="Color" Value="{x:Static local:Ui.Accent}" />
            </Style>
            <Style TargetType="ProgressBar">
                <Setter Property="ProgressColor" Value="{x:Static local:Ui.Accent}" />
                <Setter Property="BackgroundColor" Value="{x:Static local:Ui.SurfaceRaised}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
