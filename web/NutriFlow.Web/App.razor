@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@inject IWebAssemblyHostEnvironment Environment

<UiRoot>
    <NutriFlowApp DeveloperTools="@(Environment.IsDevelopment() ? _developerTools : null)" />
</UiRoot>

@code {
    private readonly RenderFragment<Guid> _developerTools = profileId => @<DeveloperTools ProfileId="profileId" />;
}
