@* development only: a quick diary entry or label-photo product without Groq, and the component showcase in every theme *@
@using NutriFlow.Infrastructure.LabelPhotos
@using NutriFlow.Infrastructure.Persistence
@using NutriFlow.Ui.Hosting
@using NutriFlow.Web.Services
@inject LocalMealClient Meals
@inject WebProfileDatabase Databases
@inject IAppHost Host
@inject WebProfileSettings Settings
@inject ThemeManager Themes
@inject ActionRunner Runner

<SectionHeader Title="Для разработки" />
<Card TestId="developer-tools">
    <Caption>Видно только в режиме разработки.</Caption>
    <ActionButton Text="Добавить тестовую запись" Secondary="true" TestId="dev-add-entry" OnClick="AddEntryAsync" />
    @if (_added is not null)
    {
        <Caption TestId="dev-added">@_added</Caption>
    }
    <ActionButton Text="Добавить продукт с фото этикетки" Secondary="true" TestId="dev-add-label-product" OnClick="AddLabelProductAsync" />
    <ActionButton Text="Открыть витрину компонентов" Secondary="true" TestId="dev-showcase" OnClick="() => _showcase = true" />
</Card>

@if (_showcase)
{
    <FormPage Title="Витрина компонентов" TestId="dev-showcase-form" OnClose="CloseShowcaseAsync">
        <ComponentShowcase />
    </FormPage>
}

@code {
    private static readonly ProductResponse[] Samples =
    [
        Sample("Гречка отварная", 110m, 3.6m, 1.3m, 21.3m),
        Sample("Куриная грудка", 165m, 31m, 3.6m, 0m),
        Sample("Творог 5 %", 121m, 17.2m, 5m, 1.8m),
        Sample("Овсянка на воде", 88m, 3m, 1.7m, 15m)
    ];

    private bool _showcase;
    private string? _added;

    [Parameter, EditorRequired]
    public Guid ProfileId { get; set; }

    private static ProductResponse Sample(string name, decimal calories, decimal protein, decimal fat, decimal carbs) =>
        new($"{name} (тест)", calories, protein, fat, carbs, "ManualInput", "Exact", "Ручной ввод", null, null);

    // the same path as a manual portion on the phone: product, preview, confirmation
    private Task AddEntryAsync() => Runner.RunAsync(async () =>
    {
        ProductResponse product = Samples[Random.Shared.Next(Samples.Length)];
        await Meals.AddProductAsync(ProfileId, product);
        MealSessionResponse session = await Meals.CreateManualMealAsync(ProfileId, product, 150m, DateOnly.FromDateTime(DateTime.Today));
        await Meals.ConfirmAsync(ProfileId, session.Id, session.PreviewToken);
        _added = $"Добавлено за сегодня: {product.Name}, 150 г.";
    });

    // a product read from a label photo, without groq: the photo goes where the label reader puts it, so backups
    // and the profile files carry it like a real one
    private Task AddLabelProductAsync() => Runner.RunAsync(async () =>
    {
        string photos = Path.Combine(PersistentDirectory.MemoryRoot, "profiles", ProfileId.ToString("N"), "label-photos");
        string reference;
        await using (NutriFlowDbContext context = await Databases.OpenAsync("", ProfileId, default))
        {
            reference = await new LabelPhotoStore(context, photos, ProfileId).SaveAsync(LabelPhotoValidator.Validate(TestPng, "image/png"));
        }

        await Host.SaveProfileFilesAsync();
        string name = $"Йогурт с этикетки {Random.Shared.Next(100, 1000)} (тест)";
        await Meals.AddProductAsync(ProfileId, new ProductResponse(name, 80m, 4m, 2.5m, 10m, "LabelPhoto", "Estimated",
            "Фото этикетки", reference, null));
        _added = $"Добавлен продукт «{name}» с фото этикетки.";
    });

    // a 1x1 png
    private static readonly byte[] TestPng = Convert.FromBase64String(
        "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFBQIAX8jx0gAAAABJRU5ErkJggg==");

    // the showcase switches themes freely, the profile keeps its own
    private async Task CloseShowcaseAsync()
    {
        _showcase = false;
        await Themes.ApplyAsync(await Settings.GetThemeAsync(ProfileId));
    }
}
