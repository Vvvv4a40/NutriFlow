@* development-only check of the browser storage until the real screens use it *@
@using NutriFlow.Api.Contracts
@using NutriFlow.Domain
@using NutriFlow.Mobile.Core
@using NutriFlow.Web.Services
@inject LocalProfileStore Profiles
@inject LocalMealClient Meals
@inject LocalInputDraftStore Drafts
@inject WebProfileSettings Settings
@inject PersistentDirectory Files
@inject BrowserPlatform Platform

<Card TestId="storage-check" Label="Проверка хранилища">
    <Overline>Проверка хранилища · только в разработке</Overline>
    <p class="nf-text" data-testid="storage-profiles">Профилей: @_profileCount · выбран: @(_selected?.Name ?? "нет")</p>
    <p class="nf-text" data-testid="storage-data">Продуктов: @_productCount · черновик: «@_draft» · тема: @_theme</p>
    <p class="nf-caption" data-testid="storage-persisted">Защита от очистки браузером: @(_persisted ? "есть" : "нет")</p>
    <ActionButton Text="Создать профиль" TestId="storage-create-profile" OnClick="CreateProfileAsync" />
    <ActionButton Text="Записать продукт, черновик и тему" Secondary="true" TestId="storage-write" Enabled="@(_selected is not null)" OnClick="WriteAsync" />
    @if (_error is not null)
    {
        <p class="nf-caption nf-tone-danger" role="alert">@_error</p>
    }
</Card>

@code {
    private int _profileCount;
    private LocalProfile? _selected;
    private int _productCount;
    private string _draft = "";
    private string _theme = "";
    private bool _persisted;
    private string? _error;

    protected override Task OnInitializedAsync() => RunAsync(RefreshAsync);

    private Task CreateProfileAsync() => RunAsync(async () =>
    {
        LocalProfile profile = await Profiles.CreateAsync($"Проверка {_profileCount + 1}");
        await Profiles.SelectAsync(profile.Id);
        await Files.FlushAsync();
        await Platform.RequestPersistenceAsync();
        await RefreshAsync();
    });

    private Task WriteAsync() => RunAsync(async () =>
    {
        Guid profileId = _selected!.Id;
        string stamp = DateTime.Now.ToString("HH:mm:ss");
        await Meals.AddProductAsync(profileId, new ProductResponse($"Продукт {stamp}", 100m, 10m, 5m, 15m,
            "ManualInput", "Exact", "Ручной ввод", null, null));
        await Drafts.SaveAsync(profileId, new LocalInputDraft($"Черновик {stamp}", DateOnly.FromDateTime(DateTime.Now), MealSessionPurpose.Diary));
        await Settings.SaveThemeAsync(profileId, _theme == "taiga" ? WebProfileSettings.DefaultTheme : "taiga");
        await Files.FlushAsync();
        await RefreshAsync();
    });

    private async Task RefreshAsync()
    {
        _profileCount = (await Profiles.ListAsync()).Count;
        _selected = await Profiles.GetSelectedAsync();
        if (_selected is not null)
        {
            _productCount = (await Meals.SearchProductsAsync(_selected.Id)).Count;
            _draft = (await Drafts.ReadAsync(_selected.Id))?.Text ?? "";
            _theme = await Settings.GetThemeAsync(_selected.Id);
        }

        _persisted = await Platform.IsPersistedAsync();
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            _error = null;
            await action();
        }
        catch (Exception exception)
        {
            _error = exception.ToString();
        }
    }
}
